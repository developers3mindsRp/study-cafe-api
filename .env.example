# MySQL (required on the server: match GRANTs for the host MySQL sees as the client, e.g. 'user'@'10.%.%'.)
# Avoid MYSQL_USER=root for remote DBs; use a dedicated app user. If you see "Access denied for user 'root'@'…'",
# fix credentials here (this file should override a polluted PM2/shell when using ecosystem.config.cjs with override: true)
# and grant in MySQL: e.g. CREATE USER 'studycafe_user'@'%' … GRANT ON studycafe_db.* …
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=studycafe_user
# MYSQL_PASSWORD=
# MYSQL_DATABASE=studycafe_db

# JWT (use strong secrets in production)
JWT_SECRET=studycafe-jwt-secret-change-in-production
JWT_REFRESH_SECRET=studycafe-refresh-secret

# Service-to-service auth (same value across auth, course, order, admin)
INTERNAL_API_KEY=studycafe-internal-key

# Inter-service HTTP URLs (ecosystem.config.cjs / PM2: set all six, or set INTERNAL_SERVICE_HOST=127.0.0.1 to default http://HOST:port)
# INTERNAL_SERVICE_HOST=127.0.0.1
# AUTH_SERVICE_URL=http://127.0.0.1:4001
# COURSE_SERVICE_URL=http://127.0.0.1:4002
# ORDER_SERVICE_URL=http://127.0.0.1:4003
# ADMIN_SERVICE_URL=http://127.0.0.1:4004
# PLATFORM_SERVICE_URL=http://127.0.0.1:4005
# DOWNLOADS_SERVICE_URL=http://127.0.0.1:4006

# Optional: override Razorpay at runtime (otherwise set via Admin panel)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Migration / sync (source DB → microservices DB). Used by scripts/migrate-wp-to-ms.js and npm run sync.
# Omit to use defaults: source 127.0.0.1:3306/studycafe (root), target 127.0.0.1:3306/studycafe_db (studycafe_user).
# MIGRATION_SRC_HOST=127.0.0.1
# MIGRATION_SRC_PORT=3306
# MIGRATION_SRC_USER=root
# MIGRATION_SRC_PASSWORD=root
# MIGRATION_SRC_DATABASE=studycafe
# MIGRATION_TGT_HOST=127.0.0.1
# MIGRATION_TGT_PORT=3306
# MIGRATION_TGT_USER=studycafe_user
# MIGRATION_TGT_PASSWORD=GDZ@p84i-F2X
# MIGRATION_TGT_DATABASE=studycafe_db
#
# File uploads: in NODE_ENV=production, platform + user images use /var/www/html/study-cafe-media/uploads/YYYY/MM/ (WordPress-style).
# Public URLs persisted in the DB are ALWAYS absolute and default to https://assets.studycafe.in/uploads/...
# (regardless of NODE_ENV) so the value stored is exactly what the frontend should render.
# Override the public origin with ASSETS_BASE_URL (e.g. for staging or local CDN testing).
# UPLOADS_DIR=
# USER_UPLOADS_DIR=
# ASSETS_BASE_URL=
# CERTIFICATES_UPLOAD_DIR=
