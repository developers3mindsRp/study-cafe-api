# Copy to .env — all values required; no defaults in code.
# PORT is set per service via npm scripts / PM2 (not shared in this file).

LOG_LEVEL=

# API request/response audit logging (shared middleware on all services)
API_REQUEST_LOGGER_ENABLED=

MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_POOL_SIZE=

REDIS_URL=

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=
REFRESH_EXPIRY=
OTP_PEPPER=
OTP_TTL_SECONDS=
LOGIN_OTP_RATE_PER_HOUR=
CACHE_TTL=

INTERNAL_API_KEY=

AUTH_SERVICE_URL=
COURSE_SERVICE_URL=
ORDER_SERVICE_URL=
ADMIN_SERVICE_URL=
PLATFORM_SERVICE_URL=
DOWNLOADS_SERVICE_URL=

# AES-256 key material for payment gateway credentials at rest (falls back to JWT_SECRET if unset)
PAYMENT_SECRETS_ENCRYPTION_KEY=

# Optional emergency fallback only when admin-service is unreachable.
# Prefer dynamic keys from Admin → Settings → Payment Gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

PUBLIC_SITE_URL=
PUBLIC_BASE_URL=
FRONTEND_URL=
ASSETS_BASE_URL=

RATE_LIMIT_WINDOW=
RATE_LIMIT_MAX=
OUTBOX_POLL_MS=

NODE_ENV=
ARTICLE_PUBLISH_QUEUE_NAME=
ARTICLE_PUBLISH_WORKER_CONCURRENCY=
ENABLE_ARTICLE_POLLING=
ARTICLE_POLL_INTERVAL_MS=

MIGRATION_SRC_HOST=
MIGRATION_SRC_PORT=
MIGRATION_SRC_USER=
MIGRATION_SRC_PASSWORD=
MIGRATION_SRC_DATABASE=
MIGRATION_TGT_HOST=
MIGRATION_TGT_PORT=
MIGRATION_TGT_USER=
MIGRATION_TGT_PASSWORD=
MIGRATION_TGT_DATABASE=

SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

