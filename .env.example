# JWT (use strong secrets in production)
JWT_SECRET=studycafe-jwt-secret-change-in-production
JWT_REFRESH_SECRET=studycafe-refresh-secret

# Service-to-service auth (same value across auth, course, order, admin)
INTERNAL_API_KEY=studycafe-internal-key

# course-service → auth-service (in Kubernetes/cluster use the service URL; 127.0.0.1 is for local all-on-one host)
# AUTH_SERVICE_URL=http://auth-service:4001

# Optional: override Razorpay at runtime (otherwise set via Admin panel)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Migration / sync (source DB → microservices DB). Used by scripts/migrate-wp-to-ms.js and npm run sync.
# Omit to use defaults: source 127.0.0.1:3306/studycafe (root), target 127.0.0.1:3306/studycafe_db (studycafe_user).
# MIGRATION_SRC_HOST=127.0.0.1
# MIGRATION_SRC_PORT=3306
# MIGRATION_SRC_USER=root
# MIGRATION_SRC_PASSWORD=root
# MIGRATION_SRC_DATABASE=studycafe
# MIGRATION_TGT_HOST=127.0.0.1
# MIGRATION_TGT_PORT=3306
# MIGRATION_TGT_USER=studycafe_user
# MIGRATION_TGT_PASSWORD=GDZ@p84i-F2X
# MIGRATION_TGT_DATABASE=studycafe_db
#
# File uploads: in NODE_ENV=production, paths are fixed in shared/persistentDataRoot.js (default /var/lib/studycafe-ms/...).
# Optional: override a single service path only if needed
# UPLOADS_DIR=
# USER_UPLOADS_DIR=
# CERTIFICATES_UPLOAD_DIR=
